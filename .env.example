# Copy to .env.local for local work. Production values live in Vercel > Project > Settings > Environment Variables.

# Canonical origin, no trailing slash. On Vercel it defaults to https://www.adaptral.com.
NEXT_PUBLIC_SITE_URL=

# Where "Talk to founders" goes (Calendly, Cal.com...). Empty: the buttons stay inert.
NEXT_CALENDLY_URL=

# Analytics. Empty string turns one off; unset uses the defaults in src/app/site.ts.
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_CLARITY_ID=

# Blog covers (npm run blog:cover). Local only: never set these in Vercel.
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2
