# Copy to .env.local for local work; set the same keys in Vercel > Project > Settings > Environment Variables.

# Canonical origin, no trailing slash. Drives canonical URL, sitemap, robots, Open Graph and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://adaptral.com

# Where "Book a call with us" goes (Cal.com, Calendly, HubSpot meetings...).
NEXT_PUBLIC_BOOKING_URL=https://cal.com/adaptral

# Google Analytics 4 measurement ID (G-XXXXXXXXXX). Leave empty to load nothing.
NEXT_PUBLIC_GA_ID=

# Microsoft Clarity project ID. Leave empty to load nothing.
NEXT_PUBLIC_CLARITY_ID=

# Google Search Console > HTML tag method: the content="..." value only.
GOOGLE_SITE_VERIFICATION=
